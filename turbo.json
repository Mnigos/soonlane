{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".vercel/output/**"],
      "env": ["VERCEL_GIT_COMMIT_SHA", "VERCEL_ENV", "VITE_POSTHOG_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "globalDependencies": ["apps/web/.env.local", "version.json", "CHANGELOG.md"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "AUTH_SECRET",
    "AUTH_URL",
    "ALLOWED_EMAILS",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "OAUTH_PROXY_SECRET",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL",
    "NODE_ENV",
    "CI"
  ]
}
