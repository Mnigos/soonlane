{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"],
      "env": [
        "RAILWAY_GIT_COMMIT_SHA",
        "APP_ENV",
        "VITE_POSTHOG_KEY",
        "VITE_API_URL",
        "VITE_SITE_URL",
        "VITE_AUTH_COOKIE_PREFIX"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "globalDependencies": ["apps/web/.env.local", "version.json", "CHANGELOG.md"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "AUTH_SECRET",
    "APP_URL",
    "ALLOWED_EMAILS",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "API_INTERNAL_URL",
    "API_PROXY_SECRET",
    "NODE_ENV",
    "CI"
  ]
}
