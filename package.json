{
  "name": "soonlane",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "zod": "^4.5.4",
      "effect": "4.0.0-rc.112",
      "@orpc/client": "2.0.0-beta.34",
      "@orpc/contract": "2.0.0-beta.34",
      "@orpc/server": "2.0.0-beta.34",
      "@orpc/experimental-effect": "2.0.0-beta.34",
      "@orpc/tanstack-query": "2.0.0-beta.34",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "pg": "^8.23.0",
      "@types/pg": "^8.15.6",
      "better-auth": "^1.7.7",
      "vite": "8.2.2",
      "@types/bun": "^1.3.14",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@types/react": "^19.2.13",
      "@types/react-dom": "^19.2.3",
      "@tanstack/react-query": "^5.102.8",
      "@tanstack/react-router": "^1.170.32",
      "@tanstack/react-router-ssr-query": "^1.167.2",
      "@tanstack/react-start": "^1.168.49",
      "@tanstack/router-plugin": "^1.168.35",
      "@tanstack/virtual-file-routes": "^1.161.7",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@vitejs/plugin-react": "^6.1.1",
      "nitro": "^3.0.1-alpha.2"
    }
  },
  "scripts": {
    "dev": "turbo dev --filter=@soonlane/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.json",
    "check": "ultracite check",
    "check:fix": "ultracite fix --unsafe",
    "prepare": "husky",
    "commit": "cz",
    "db:generate": "bun --filter @soonlane/db db:generate",
    "db:migrate": "bun --filter @soonlane/db db:migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@soonlane/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "git-cliff": "2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "railway": "3.16.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.12.2"
  },
  "overrides": {
    "drizzle-orm": "1.0.0-rc.4",
    "vite": "8.2.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "npm": "please-use-bun",
    "yarn": "please-use-bun"
  },
  "packageManager": "bun@1.4.2"
}
