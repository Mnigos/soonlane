# Copy to apps/mobile/.env.local to point `bun run start` at another API, with that API's AUTH_COOKIE_PREFIX. A physical iPhone cannot reach the Mac's localhost.
EXPO_PUBLIC_API_URL=https://api.staging.soonlane.com
EXPO_PUBLIC_AUTH_COOKIE_PREFIX=soonlane-staging
EXPO_PUBLIC_APP_ENV=development
# PostHog's public project key (docs/analytics.md); empty sends nothing.
EXPO_PUBLIC_POSTHOG_KEY=
