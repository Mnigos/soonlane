{
  "cli": {
    "version": ">= 27.7.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.soonlane.com",
        "EXPO_PUBLIC_AUTH_COOKIE_PREFIX": "soonlane-staging",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_WEB_URL": "https://app.staging.soonlane.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.soonlane.com",
        "EXPO_PUBLIC_AUTH_COOKIE_PREFIX": "soonlane-staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_WEB_URL": "https://app.staging.soonlane.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.soonlane.com",
        "EXPO_PUBLIC_AUTH_COOKIE_PREFIX": "soonlane",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_WEB_URL": "https://app.soonlane.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6836829840",
        "appleTeamId": "UC8ZVHA9UD",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "TKJTQR47BX",
        "ascApiKeyIssuerId": "e56b0742-3fc7-4db9-9074-4f46fab33245"
      }
    }
  }
}
