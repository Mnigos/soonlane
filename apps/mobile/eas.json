{
  "cli": {
    "version": ">= 27.7.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.soonlane.com",
        "EXPO_PUBLIC_AUTH_COOKIE_PREFIX": "soonlane-staging"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.soonlane.com",
        "EXPO_PUBLIC_AUTH_COOKIE_PREFIX": "soonlane-staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.soonlane.com",
        "EXPO_PUBLIC_AUTH_COOKIE_PREFIX": "soonlane"
      }
    }
  }
}
