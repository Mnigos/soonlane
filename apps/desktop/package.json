{
  "name": "@soonlane/desktop",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "APP_URL=http://localhost:3000 API_URL=http://localhost:4000 bun run view && APP_URL=http://localhost:3000 API_URL=http://localhost:4000 bunx --bun electrobun dev",
    "view": "bun run sdk && bunx --bun vite build",
    "package": ": \"${APP_URL:?set APP_URL to the web app URL}\" \"${API_URL:?set API_URL to the API URL}\" && bun run view && bunx --bun electrobun build --env=stable",
    "sdk": "bunx --bun electrobun prepare",
    "typecheck": "bun run sdk && tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@soonlane/app": "workspace:*",
    "@soonlane/auth": "workspace:*",
    "@soonlane/contracts": "workspace:*",
    "@soonlane/domain": "workspace:*",
    "@soonlane/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "effect": "catalog:",
    "lucide-react": "^1.56.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "2.0.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@soonlane/tailwind-config": "workspace:*",
    "@soonlane/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electrobun": "2.0.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
