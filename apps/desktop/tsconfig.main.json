{
  "extends": "@soonlane/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "types": ["bun"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.main.json",
    "paths": {
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/*": ["./.hutch/devkit/api/sdks/main/entries/*.ts"]
    }
  },
  "include": [
    "src/main.ts",
    "src/platform/**/*.ts",
    "src/modules/*/domain/**/*.ts",
    "src/modules/*/application/**/*.ts",
    "src/modules/*/infrastructure/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"
  ],
  "exclude": ["src/platform/rpc/*.client.ts"]
}
