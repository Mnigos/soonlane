{
  "extends": "@soonlane/typescript-config/react-library.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.page.json",
    "paths": {
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    }
  },
  "include": [
    "src/view.tsx",
    "src/router.tsx",
    "src/build-info.types.ts",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    "src/modules/*/presentation/**/*.ts",
    "src/modules/*/presentation/**/*.tsx",
    "src/platform/rpc/*.client.ts",
    "src/platform/rpc/page-rpc.types.ts"
  ]
}
