# Copy to apps/api/.env.local and fill in the secrets.
PORT=4000
APP_ENV=development
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
LANDING_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000
AUTH_COOKIE_PREFIX=soonlane-dev
# The commit the API reports in /health; Railway builds set their own.
APP_COMMIT=dev
# The Postgres from compose.yaml (bun run db:up).
DATABASE_URL=postgres://soonlane:soonlane@localhost:5433/soonlane
AUTH_SECRET=
# Optional, both or neither: Google sign-in. With neither Google nor email set up, the API refuses to start outside development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: email codes, EMAIL_FROM with exactly one of RESEND_API_KEY and SMTP_URL. Unset in development, codes go to the API's log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=
# Must equal API_PROXY_SECRET in apps/web/.env.local.
API_PROXY_SECRET=
# Optional, comma-separated: only these addresses can create an account. Unset means anyone can.
ALLOWED_EMAILS=
# Optional: PostHog's project key. Unset, the API sends nothing.
POSTHOG_KEY=
# Optional: a PostHog personal API key with person:write. Unset while POSTHOG_KEY is set, deleted accounts' PostHog persons wait in person_deletion until it is set.
POSTHOG_PERSONAL_API_KEY=
# Optional, both or neither: the Todoist app for Import from Todoist.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
