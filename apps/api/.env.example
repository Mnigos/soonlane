# Copy to apps/api/.env.local and fill in the secrets.
PORT=4000
APP_ENV=development
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
AUTH_COOKIE_PREFIX=soonlane-dev
# The Postgres from compose.yaml (bun run db:up).
DATABASE_URL=postgres://soonlane:soonlane@localhost:5433/soonlane
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal API_PROXY_SECRET in apps/web/.env.local.
API_PROXY_SECRET=
# Optional, comma-separated: only these addresses can create an account. Unset means anyone can.
ALLOWED_EMAILS=
# Optional: PostHog's project key. Unset, the API sends nothing.
POSTHOG_KEY=
# Optional, both or neither: the Todoist app for Import from Todoist.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
