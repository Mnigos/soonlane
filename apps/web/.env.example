# Copy to apps/web/.env.local and fill in. The web app needs no database.
VITE_API_URL=http://localhost:4000
VITE_AUTH_COOKIE_PREFIX=soonlane-dev
API_INTERNAL_URL=http://localhost:4000
# Must equal API_PROXY_SECRET in apps/api/.env.local.
API_PROXY_SECRET=
# Optional: PostHog's public project key (phc_…). Unset, nothing is sent and /ingest answers 404.
VITE_POSTHOG_KEY=
