# Pull real values with: bunx vercel@latest env pull apps/web/.env.local --environment=development --scope mnigos-projects --yes
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_URL=http://localhost:3000
AUTH_SECRET=
# Optional, comma-separated: only these addresses can create an account. Unset means anyone can.
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; must match between Production and Preview when set.
OAUTH_PROXY_SECRET=
# Local QA only: the production Neon endpoint host that dev-session must never touch.
PRODUCTION_DATABASE_HOST=
# Optional: PostHog's public project key (phc_…). Unset, nothing is sent and /ingest answers 404.
VITE_POSTHOG_KEY=
