# Copy to .env next to compose.yaml and fill in. Generate each secret with `openssl rand -hex 32`.

# The address people open, without a trailing slash. Anything but localhost needs https in front (README, Self-hosting).
SOONLANE_URL=http://localhost:8080
# Where the proxy listens on this machine; 0.0.0.0:8080 makes it reachable from other machines.
SOONLANE_LISTEN=127.0.0.1:8080
# An image tag: latest, a release such as 0.3.0, or main.
SOONLANE_VERSION=latest

# Letters and digits only: it goes into the database URL as is.
POSTGRES_PASSWORD=
# At least 32 characters; signs sessions.
AUTH_SECRET=
# Lets the web server pass the visitor's address to the API.
API_PROXY_SECRET=

# A Google OAuth client of type Web application, with the redirect URI <SOONLANE_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma-separated addresses that may sign up; unset, any Google account can.
# ALLOWED_EMAILS=you@example.com

# Optional, both or neither: a Todoist app for Import from Todoist, with the redirect URI <SOONLANE_URL>/api/auth/callback/todoist.
# TODOIST_CLIENT_ID=
# TODOIST_CLIENT_SECRET=
